# Copy to .env for local development. Never commit .env.
# These are server-only values; do not prefix them with VITE_.

# Base URL of the private Yaqadha risk model API (Render), without a path,
# e.g. https://yaqadha-api-v1-1.onrender.com — the server calls /api/v1/risk/evaluate on it
RISK_API_URL=

# API key sent server-side to the risk model (X-API-Key header)
RISK_API_KEY=

# Optional: enables Gemini analysis for /api/audit/ai-analyze
GEMINI_API_KEY=
