# Copy to .env for local development. Never commit .env.
# These are server-only values; do not prefix them with VITE_.

# Base URL of the private Yaqadha risk model API (Render)
YAQADHA_API_BASE_URL=

# API key sent server-side to the private risk model
YAQADHA_API_KEY=

# Optional: enables Gemini analysis for /api/audit/ai-analyze
GEMINI_API_KEY=
